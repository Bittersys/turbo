	0000-0005 PSH _CONSTANTE	         Integer	0000:0011
	0000-000A EQC
	0000-000B PSH _VARIABLE  	         Integer	0000:0000
	0000-0010 PSH _CONSTANTE	         Integer	0000:0013
	0000-0015 EQC
	0000-0016 ORC
	0000-0017 IFC 0024
	0000-001A PSH _CONSTANTE	         Integer	0000:0015
	0000-001F SAV
	0000-0020 RTN
	0000-0021 JMP 0045
	0000-0024 PSH _VARIABLE  	         Integer	0000:0000
	0000-0029 PSH _VARIABLE  	         Integer	0000:0000
	0000-002E PSH _CONSTANTE	         Integer	0000:0017
	0000-0033 SUB
	0000-0034 ALC 0000:0004
	0000-0039 CPY 0001
	0000-003B CLL 0000:0000
	0000-003D SUM
	0000-003E STK 0001:0001
	0000-0041 FRE
	0000-0042 MUL
	0000-0043 SAV
	0000-0044 RTN
INICIO >
	0000-0045 ALC 0045:0004
	0000-004A PSH _VARIABLE  	         Integer	0000:0000
	0000-004F PSH _CONSTANTE	         Integer	0000:0019
	0000-0054 ASG
	0000-0055 PSH _CONSTANTE	         String 	0000:0021
	0000-005A WRT
	0000-005B PSH _VARIABLE  	         Integer	0000:0000
	0000-0060 WRT
	0000-0061 PSH _CONSTANTE	         String 	0000:0039
	0000-0066 WRT
	0000-0067 PSH _VARIABLE  	         Integer	0000:0000
